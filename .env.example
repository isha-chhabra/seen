# Postgres password — pick any random string, just keep it consistent
POSTGRES_PASSWORD=change-this-to-something-random

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-this-to-a-random-32-char-string

# Your branding
APP_NAME=YourToolName
APP_ICON=https://link-to-your-logo.png
APP_URL=http://your-server-ip:1515

# BrightData
BRIGHTDATA_API_TOKEN=your-brightdata-token

# Which engines to track (no Claude — BrightData doesn't cover it)
SCRAPE_TARGETS=chatgpt:brightdata:online,google-ai-mode:brightdata:online,gemini:brightdata:online,google-ai-overview:brightdata:online,perplexity:brightdata:online
