{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreWorkspaces": [
    "packages/ui"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "turbo.json"
      ]
    },
    "apps/web": {
      "entry": [
        "src/routes/**/*.{ts,tsx}!",
        "src/server.ts",
        "scripts/*.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.ts"
      ],
      "ignoreDependencies": [
        "tailwindcss",
        "tw-animate-css",
        "@tailwindcss/typography",
        "@fontsource/geist-sans",
        "@base-ui/react"
      ]
    },
    "apps/worker": {
      "entry": [
        "scripts/test-provider.ts"
      ]
    }
  }
}
